node_modules/
.pnpm-store/
.wrangler/
*.log
*.tsbuildinfo
test-results/
playwright-report/

# Environment files and local secrets must never be committed.
**/.env
**/.env.*
**/.dev.vars
**/.dev.vars.*
!**/.env.example
!**/.env.*.example

# Private keys, certificates, credentials, and secret stores.
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/credentials*.json
**/service-account*.json
**/*-credentials.json
**/*-secrets.json
